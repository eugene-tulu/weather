{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://dynamical.org https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.amazonaws.com; font-src 'self' data:; connect-src 'self' https://dynamical.org https://*.amazonaws.com https://s3.amazonaws.com https://unpkg.com https://cdn.jsdelivr.net https://storage.googleapis.com https://epsg.io; worker-src 'self' blob: https://dynamical.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "geolocation=(self), microphone=(), camera=()"
	}

	handle /mcp* {
		reverse_proxy mcp:8001
	}

	handle /admin* {
		reverse_proxy backend:8000
	}

	handle /v1/* {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}