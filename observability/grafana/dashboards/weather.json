{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(weather_http_requests_total[5m])) by (path)", "legendFormat": "{{path}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(weather_http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}"}]
    },
    {
      "type": "timeseries",
      "title": "MCP tool calls",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(weather_mcp_tool_calls_total[5m])) by (tool, status)", "legendFormat": "{{tool}} {{status}}"}]
    },
    {
      "type": "stat",
      "title": "Quota rejections (1h)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(weather_quota_rejections_total[1h]))"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["weather", "mcp"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Weather Decision",
  "uid": "weather-decision",
  "version": 1
}
