# Public hostname for the HTTPS reverse proxy. Use a real domain for a
# publicly trusted certificate; localhost uses Caddy's internal CA.
DOMAIN=weather.example.com
NEXT_PUBLIC_SITE_URL=https://weather.example.com

ALLOWED_ORIGINS=https://weather.example.com,http://localhost:3000

RATE_LIMIT_PER_MINUTE=120
OUTBOUND_RATE_PER_10S=20
OUTBOUND_RATE_PER_60S=250

CACHE_TTL_SECONDS=600
CACHE_MAX_ROWS=10000